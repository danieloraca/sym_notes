# Copy this file to .env for local development or Raspberry Pi deployment.
# Keep real secrets in .env, exported environment variables, or Symfony secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> mysql ###
MYSQL_DATABASE=sym_notes
MYSQL_USER=sym_notes
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
###< mysql ###

###> MCP server ###
# Generate with: openssl rand -hex 32
MCP_TOKEN=
MCP_USER_EMAIL=
MCP_ALLOWED_HOSTS=192.168.0.25,localhost,127.0.0.1
###< MCP server ###
