{% extends 'base.html.twig' %}

{% block title %}Edit Note - Sym Notes{% endblock %}

{% block body %}
    <main class="page-shell">
        <section class="editor-panel" aria-labelledby="note-form-title">
            <p class="eyebrow">Edit note</p>
            <h1 id="note-form-title">{{ note.title }}</h1>

            {% include 'notes/_form.html.twig' with {
                form: form,
                button_label: 'Save Note',
                cancel_path: path('notes_show', {id: note.id})
            } only %}
        </section>
    </main>
{% endblock %}
