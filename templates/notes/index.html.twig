{% extends 'base.html.twig' %}
{% import 'notes/_folder_tree.html.twig' as folder_tree %}

{% block title %}Notes - Sym Notes{% endblock %}

{% block body %}
    <main class="page-shell">
        <section class="hero-panel" aria-labelledby="page-title">
            <div class="hero-copy">
                <p class="eyebrow">Personal notes</p>
                <h1 id="page-title">Keep the signal close.</h1>
                        <p class="lede">
                            {% if current_folder %}
                                Notes filed under {{ current_folder.path }}.
                            {% else %}
                                A focused home for notes, references, tiny decisions, and the useful fragments that deserve to be found again.
                            {% endif %}
                        </p>
                <div class="hero-actions" aria-label="Note actions">
                    <a class="button button-primary" href="{{ path('notes_new') }}">New Note</a>
                    <a class="button button-secondary" href="{{ path('folders_new') }}">New Folder</a>
                </div>
            </div>

            <div class="note-stack" aria-hidden="true">
                <div class="stack-card stack-card-back">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="stack-card stack-card-mid">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="stack-card stack-card-front">
                    <div class="stack-header">
                        <span></span>
                        <span></span>
                    </div>
                    <strong>Weekly shape</strong>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </section>

        <section class="stat-strip" aria-label="Notes summary">
            <div>
                <span class="stat-value">{{ stats.notes }}</span>
                <span class="stat-label">Notes</span>
            </div>
            <div>
                <span class="stat-value">{{ stats.pinned }}</span>
                <span class="stat-label">Pinned</span>
            </div>
            <div>
                <span class="stat-value">{{ stats.drafts }}</span>
                <span class="stat-label">Drafts</span>
            </div>
            <div>
                <span class="stat-value">MySQL</span>
                <span class="stat-label">Storage</span>
            </div>
        </section>

        <section class="workspace" aria-label="Notes workspace">
            <aside class="sidebar" aria-label="Note filters">
                <div class="section-label">Views</div>
                <a class="filter-link {{ app.request.attributes.get('_route') == 'notes_index' ? 'is-active' : '' }}" href="{{ path('notes_index') }}">
                    <span><i class="filter-dot dot-teal" aria-hidden="true"></i>All notes</span>
                    <strong>{{ stats.notes }}</strong>
                </a>
                <a class="filter-link" href="{{ path('notes_index') }}">
                    <span><i class="filter-dot dot-gold" aria-hidden="true"></i>Pinned</span>
                    <strong>{{ stats.pinned }}</strong>
                </a>
                <a class="filter-link" href="{{ path('notes_index') }}">
                    <span><i class="filter-dot dot-rose" aria-hidden="true"></i>Drafts</span>
                    <strong>{{ stats.drafts }}</strong>
                </a>
                <div class="section-label sidebar-gap">Folders</div>
                <a class="filter-link {{ app.request.attributes.get('_route') == 'notes_uncategorized' ? 'is-active' : '' }}" href="{{ path('notes_uncategorized') }}">
                    <span><i class="filter-dot dot-blue" aria-hidden="true"></i>Uncategorized</span>
                    <strong>{{ uncategorized_count }}</strong>
                </a>
                <div class="folder-tree" data-folder-tree>
                    {{ folder_tree.links(folders, null, current_folder, folder_counts) }}
                </div>
                <a class="filter-link" href="{{ path('folders_new') }}">
                    <span><i class="filter-dot dot-gold" aria-hidden="true"></i>New folder</span>
                    <strong>+</strong>
                </a>
            </aside>

            <section class="notes-panel" aria-label="Notes">
                <div class="toolbar">
                    <form class="search-field" method="get" action="{{ path(app.request.attributes.get('_route'), search_route_params) }}">
                        <label>
                            <span class="visually-hidden">Search notes</span>
                            <input type="search" name="q" value="{{ search }}" placeholder="Search notes">
                        </label>
                        <button class="visually-hidden" type="submit">Search</button>
                    </form>
                    {% if current_folder %}
                        <a class="button button-secondary" href="{{ path('folders_edit', {id: current_folder.id}) }}">Edit Folder</a>
                    {% endif %}
                    <a class="button button-secondary" href="{{ path('notes_new') }}">New</a>
                </div>

                {% if notes is empty %}
                    <div class="empty-state">
                        <div class="empty-visual" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <p class="eyebrow">Fresh notebook</p>
                        <h2>Everything starts with one clean page.</h2>
                        <p>A clean slate, ready for the first entry.</p>
                        <a class="button button-primary" href="{{ path('notes_new') }}">Create Note</a>
                    </div>
                {% else %}
                    <div class="note-list">
                        {% for note in notes %}
                            <article class="note-card">
                                <div class="note-card-header">
                                    <h2><a href="{{ path('notes_show', {id: note.id}) }}">{{ note.title }}</a></h2>
                                    {% if note.pinned %}
                                        <span class="note-pill">Pinned</span>
                                    {% endif %}
                                </div>
                                {% set summary = note.content|markdown_to_html|striptags %}
                                <p>{{ summary|slice(0, 180) }}{% if summary|length > 180 %}...{% endif %}</p>
                                <div class="note-meta">
                                    <span>
                                        {% if note.folder %}
                                            {{ note.folder.path }} ·
                                        {% endif %}
                                        Updated {{ note.updatedAt|date('M j, Y H:i') }}
                                    </span>
                                    <a href="{{ path('notes_edit', {id: note.id}) }}">Edit</a>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                    {% if pagination.total_pages > 1 %}
                        <nav class="pagination" aria-label="Notes pagination">
                            <span class="pagination-summary">
                                Showing {{ pagination.first_item }}–{{ pagination.last_item }} of {{ pagination.total }}
                            </span>
                            <div class="pagination-controls">
                                {% if pagination.page > 1 %}
                                    <a class="button button-secondary" href="{{ path(app.request.attributes.get('_route'), pagination_route_params|merge({page: pagination.page - 1})) }}">Previous</a>
                                {% endif %}
                                <span class="pagination-page" aria-current="page">Page {{ pagination.page }} of {{ pagination.total_pages }}</span>
                                {% if pagination.page < pagination.total_pages %}
                                    <a class="button button-secondary" href="{{ path(app.request.attributes.get('_route'), pagination_route_params|merge({page: pagination.page + 1})) }}">Next</a>
                                {% endif %}
                            </div>
                        </nav>
                    {% endif %}
                {% endif %}
            </section>
        </section>
    </main>
{% endblock %}
