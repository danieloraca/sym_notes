{% extends 'base.html.twig' %}

{% block title %}Login - Sym Notes{% endblock %}

{% block body %}
    <main class="page-shell">
        <section class="auth-panel" aria-labelledby="login-title">
            <p class="eyebrow">Private notebook</p>
            <h1 id="login-title">Sign in</h1>

            {% if error %}
                <p class="form-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <form class="auth-form" method="post" action="{{ path('app_login') }}">
                <label>
                    <span>Email</span>
                    <input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </label>

                <label>
                    <span>Password</span>
                    <input type="password" name="_password" autocomplete="current-password" required>
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="button button-primary" type="submit">Sign in</button>
            </form>
        </section>
    </main>
{% endblock %}
