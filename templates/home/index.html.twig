{% extends 'base.html.twig' %}

{% block title %}Notes - Sym Notes{% endblock %}

{% block body %}
    <main class="page-shell">
        <section class="hero-panel" aria-labelledby="page-title">
            <div class="hero-copy">
                <p class="eyebrow">Personal notes</p>
                <h1 id="page-title">Keep the signal close.</h1>
                <p class="lede">A focused home for notes, references, tiny decisions, and the useful fragments that deserve to be found again.</p>
                <div class="hero-actions" aria-label="Note actions">
                    <button class="button button-primary" type="button">New Note</button>
                    <button class="button button-secondary" type="button">Import</button>
                </div>
            </div>

            <div class="note-stack" aria-hidden="true">
                <div class="stack-card stack-card-back">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="stack-card stack-card-mid">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="stack-card stack-card-front">
                    <div class="stack-header">
                        <span></span>
                        <span></span>
                    </div>
                    <strong>Weekly shape</strong>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </section>

        <section class="stat-strip" aria-label="Notes summary">
            <div>
                <span class="stat-value">0</span>
                <span class="stat-label">Notes</span>
            </div>
            <div>
                <span class="stat-value">0</span>
                <span class="stat-label">Pinned</span>
            </div>
            <div>
                <span class="stat-value">0</span>
                <span class="stat-label">Drafts</span>
            </div>
            <div>
                <span class="stat-value">MySQL</span>
                <span class="stat-label">Storage</span>
            </div>
        </section>

        <section class="workspace" aria-label="Notes workspace">
            <aside class="sidebar" aria-label="Note filters">
                <div class="section-label">Views</div>
                <a class="filter-link is-active" href="{{ path('app_home') }}">
                    <span><i class="filter-dot dot-teal" aria-hidden="true"></i>All notes</span>
                    <strong>0</strong>
                </a>
                <a class="filter-link" href="{{ path('app_home') }}">
                    <span><i class="filter-dot dot-gold" aria-hidden="true"></i>Pinned</span>
                    <strong>0</strong>
                </a>
                <a class="filter-link" href="{{ path('app_home') }}">
                    <span><i class="filter-dot dot-rose" aria-hidden="true"></i>Drafts</span>
                    <strong>0</strong>
                </a>
                <div class="section-label sidebar-gap">Spaces</div>
                <a class="filter-link" href="{{ path('app_home') }}">
                    <span><i class="filter-dot dot-blue" aria-hidden="true"></i>Ideas</span>
                    <strong>0</strong>
                </a>
                <a class="filter-link" href="{{ path('app_home') }}">
                    <span><i class="filter-dot dot-green" aria-hidden="true"></i>Projects</span>
                    <strong>0</strong>
                </a>
            </aside>

            <section class="notes-panel" aria-label="Notes">
                <div class="toolbar">
                    <label class="search-field">
                        <span class="visually-hidden">Search notes</span>
                        <input type="search" name="q" placeholder="Search notes">
                    </label>
                    <button class="button button-secondary" type="button">Sort</button>
                </div>

                {% if notes is empty %}
                    <div class="empty-state">
                        <div class="empty-visual" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <p class="eyebrow">Fresh notebook</p>
                        <h2>Everything starts with one clean page.</h2>
                        <p>A clean slate, ready for the first entry.</p>
                        <button class="button button-primary" type="button">Create Note</button>
                    </div>
                {% else %}
                    <div class="note-list">
                        {% for note in notes %}
                            <article class="note-card">
                                <h2>{{ note.title }}</h2>
                                <p>{{ note.summary }}</p>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </section>
    </main>
{% endblock %}
